{
  "BEAM app skeleton": {
    "prefix": "beamapp",
    "body": [
      "win = beam_open(${1:500}, ${2:300}, \"${3:My App}\")",
      "",
      "while beam_running(win)",
      "  beam_begin(win)",
      "    ${0}",
      "  beam_end(win)",
      "wend"
    ],
    "description": "A complete BEAM window with its event loop"
  },
  "Group": {
    "prefix": "group",
    "body": [
      "beam_group_begin(\"${1:Title}\")",
      "  ${0}",
      "beam_group_end()"
    ],
    "description": "A titled group of widgets"
  },
  "Panel": {
    "prefix": "panel",
    "body": ["beam_panel_begin(${1:200})", "  ${0}", "beam_panel_end()"],
    "description": "A panel region"
  },
  "Row": {
    "prefix": "row",
    "body": ["beam_row(${1:30}, ${2:1})", "  ${0}", "beam_row_end()"],
    "description": "A row laying widgets out horizontally"
  },
  "Button": {
    "prefix": "button",
    "body": [
      "if beam_button(\"${1:Click me}\", ${2:100}, ${3:30}) then",
      "  ${0}",
      "end if"
    ],
    "description": "A button and the code it runs"
  },
  "Label": {
    "prefix": "label",
    "body": ["beam_label(\"${0:Text}\")"],
    "description": "A static text label"
  },
  "Text input": {
    "prefix": "input",
    "body": [
      "if beam_input(${1:name$}, ${2:64}, ${3:300}) then",
      "  ${0}",
      "end if"
    ],
    "description": "A text entry field"
  },
  "Checkbox": {
    "prefix": "checkbox",
    "body": ["${1:flag} = beam_checkbox(\"${2:Enable}\", ${1:flag})${0}"],
    "description": "A checkbox bound to a variable"
  },
  "Slider": {
    "prefix": "slider",
    "body": ["${1:value} = beam_slider(${1:value}, ${2:0}, ${3:100})${0}"],
    "description": "A slider bound to a variable"
  },
  "Combo box": {
    "prefix": "combo",
    "body": ["${1:choice} = beam_combo(\"${2:One|Two|Three}\", ${1:choice})${0}"],
    "description": "A dropdown bound to a variable"
  },
  "Progress bar": {
    "prefix": "progress",
    "body": ["beam_progress(${0:percent})"],
    "description": "A progress bar"
  },
  "Message box": {
    "prefix": "msgbox",
    "body": ["r = beam_msgbox(\"${1:Title}\", \"${0:Message}\")"],
    "description": "A modal message dialog"
  },
  "Confirm dialog": {
    "prefix": "confirm",
    "body": ["if beam_confirm(\"${1:Title}\", \"${2:Are you sure?}\") then", "  ${0}", "end if"],
    "description": "A yes/no dialog"
  },
  "Open file dialog": {
    "prefix": "openfile",
    "body": ["${1:path$} = beam_open_file(\"${2:Open}\", \"${0:*.yab}\")"],
    "description": "A native open-file dialog"
  },
  "NMEA serial read": {
    "prefix": "nmea",
    "body": [
      "h = beam_nmea_open(\"${1:/dev/ttyUSB0}\", ${2:4800})",
      "sentence$ = beam_nmea_read(h)",
      "if sentence$ <> \"\" then",
      "  ${0}",
      "end if",
      "beam_nmea_close(h)"
    ],
    "description": "Open a serial port and read one NMEA sentence"
  },
  "If / Then": {
    "prefix": "if",
    "body": ["if ${1:condition} then", "  ${0}", "end if"],
    "description": "A multi-line IF block"
  },
  "If / Else": {
    "prefix": "ifelse",
    "body": ["if ${1:condition} then", "  ${2}", "else", "  ${0}", "end if"],
    "description": "An IF / ELSE block"
  },
  "For / Next": {
    "prefix": "for",
    "body": ["for ${1:i} = ${2:1} to ${3:10}", "  ${0}", "next ${1:i}"],
    "description": "A counted FOR loop"
  },
  "While / Wend": {
    "prefix": "while",
    "body": ["while ${1:condition}", "  ${0}", "wend"],
    "description": "A WHILE loop"
  },
  "Repeat / Until": {
    "prefix": "repeat",
    "body": ["repeat", "  ${1}", "until ${0:condition}"],
    "description": "A loop that always runs at least once"
  },
  "Do / Loop": {
    "prefix": "do",
    "body": ["do", "  ${1}", "loop"],
    "description": "A DO / LOOP block"
  },
  "Switch": {
    "prefix": "switch",
    "body": [
      "switch ${1:value}",
      "  case ${2:1}",
      "    ${3}",
      "    break",
      "  default",
      "    ${0}",
      "end switch"
    ],
    "description": "A SWITCH block"
  },
  "Subroutine": {
    "prefix": "sub",
    "body": ["sub ${1:name}(${2:arg})", "  ${0}", "end sub"],
    "description": "A subroutine"
  },
  "Export subroutine": {
    "prefix": "exportsub",
    "body": ["export sub ${1:name}(${2:arg})", "  ${0}", "end sub"],
    "description": "A subroutine visible to importing programs"
  },
  "Import": {
    "prefix": "import",
    "body": ["import ${0:library}"],
    "description": "Import a library"
  },
  "Open file": {
    "prefix": "openread",
    "body": [
      "open \"${1:data.txt}\" for reading as #1",
      "while not eof(#1)",
      "  line input #1 ${2:line$}",
      "  ${0}",
      "wend",
      "close #1"
    ],
    "description": "Read a file line by line"
  },
  "Print": {
    "prefix": "print",
    "body": ["print ${0:\"text\"}"],
    "description": "Write a line to the terminal"
  }
}
