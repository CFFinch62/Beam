  323         | tBEAM_INPUT '(' string_expression ',' expression ',' expression ')'
  324         | tBEAM_CHECKBOX '(' string_expression ',' expression ')'
  325         | tBEAM_COMBO '(' string_expression ',' expression ',' expression ',' expression ',' expression ')'
  326         | tBEAM_SLIDER '(' expression ',' expression ',' expression ',' expression ',' expression ')'
  327         | tBEAM_TIME '(' ')'
  328         | tBEAM_MSGBOX '(' string_expression ',' string_expression ')'
  329         | tBEAM_CONFIRM '(' string_expression ',' string_expression ')'

  330 const: number
  331      | '+' number
  332      | '-' number

  333 number: tFNUM
  334       | tDIGITS
  335       | tHEXDIGITS
