  187                | tFRNBF_ALLOC '(' expression ')'
  188                | tFRNBF_DUMP '(' string_expression ')'
  189                | tFRNBF_DUMP '(' string_expression ',' expression ')'
  190                | tDATE
  191                | tDATE '(' ')'
  192                | tTIME
  193                | tTIME '(' ')'
  194                | tPEEK2 '(' string_expression ')'
