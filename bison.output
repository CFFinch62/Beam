  339 dimlist: tSYMBOL '(' call_list ')'
  340        | dimlist ',' tSYMBOL '(' call_list ')'
  341        | tSTRSYM '(' call_list ')'
  342        | dimlist ',' tSTRSYM '(' call_list ')'

  343 function_or_array: tSYMBOL '(' call_list ')'

  344 stringfunction_or_array: tSTRSYM '(' call_list ')'

  345 $@11: ε

  346 call_list: $@11 calls

  347 calls: ε
  348      | call_item
  349      | calls ',' call_item

  350 call_item: string_expression
