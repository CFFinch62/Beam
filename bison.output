  196                | tTOKENALT '(' string_scalar_or_array ',' string_expression ')'
  197                | tTOKENALT '(' string_scalar_or_array ')'
  198                | tSPLITALT '(' string_scalar_or_array ',' string_expression ')'
  199                | tSPLITALT '(' string_scalar_or_array ')'
  200                | tGETBIT '(' coordinates to coordinates ')'
  201                | tGETCHAR '(' expression ',' expression to expression ',' expression ')'
  202                | tHEX '(' expression ')'
  203                | tBIN '(' expression ')'
  204                | tEXECUTE2 '(' call_list ')'
  205                | tFRNBF_GET2 '(' string_expression ',' expression ',' expression ')'
