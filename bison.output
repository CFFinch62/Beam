  210                | tBEAM_NMEA_READ '(' expression ')'
  211                | tBEAM_NMEA_FIELD '(' string_expression ',' expression ')'

  212 number_assignment: tSYMBOL tEQU expression
  213                  | function_or_array tEQU expression

  214 $@9: ε

  215 expression: expression tOR $@9 expression

  216 $@10: ε

  217 expression: expression tAND $@10 expression
  218           | tNOT expression
  219           | expression tEQU expression
  220           | expression tEQU2 expression
