  352 $@12: ε

  353 $@13: ε

  354 $@14: ε

  355 function_definition: export tSUB $@12 function_name $@13 '(' paramlist ')' $@14 statement_list endsub

  356 endsub: tEOPROG
  357       | tENDSUB

  358 function_name: tSYMBOL
  359              | tSTRSYM

  360 export: ε
