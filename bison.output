Grammar

    0 $accept: program_or_expression $end

    1 program_or_expression: tSTART_PROGRAM program
    2                      | tSTART_EXPRESSION expression tEOPROG
    3                      | tSTART_STRING_EXPRESSION string_expression tEOPROG
    4                      | tSTART_ASSIGNMENT assignment tEOPROG
    5                      | tSTART_FUNCTION_DEFINITION function_definition tEOPROG

    6 program: statement_list tEOPROG

    7 statement_list: statement

    8 $@1: ε

    9 $@2: ε

   10 statement_list: statement_list $@1 tSEP $@2 statement

   11 assignment: string_assignment
   12           | tLET string_assignment
   13           | number_assignment
   14           | tLET number_assignment

   15 statement: ε
   16          | assignment
   17          | tIMPORT
   18          | tERROR string_expression
   19          | for_loop
   20          | switch_number_or_string
   21          | repeat_loop
   22          | while_loop
   23          | do_loop
   24          | tBREAK
   25          | tBREAK tDIGITS
   26          | tCONTINUE
   27          | function_definition
   28          | function_or_array
   29          | stringfunction_or_array

   30 $@3: ε

   31 statement: tLOCAL $@3 local_list

   32 $@4: ε

   33 statement: tSTATIC $@4 static_list
   34          | if_clause
   35          | short_if
   36          | tGOTO symbol_or_lineno
   37          | tGOSUB symbol_or_lineno
   38          | tON tINTERRUPT tBREAK
   39          | tON tINTERRUPT tCONTINUE

   40 $@5: ε

   41 statement: tON expression tGOTO $@5 goto_list

   42 $@6: ε

   43 statement: tON expression tGOSUB $@6 gosub_list
   44          | tLABEL symbol_or_lineno
   45          | open_clause
   46          | tCLOSE hashed_number
   47          | seek_clause
   48          | tCOMPILE string_expression
   49          | tEXECUTE call_list
   50          | tEXECUTE2 call_list
   51          | tPRINT printintro printlist
   52          | tPRINT printintro printlist ';'
   53          | tPRINT printintro printlist ','

   54 $@7: ε

   55 statement: tINPUT $@7 inputbody

   56 $@8: ε

   57 statement: tLINE tINPUT $@8 inputbody
   58          | tCOLOUR expression ',' expression ',' expression
   59          | tCOLOUR string_expression
   60          | tBACKCOLOUR expression ',' expression ',' expression
   61          | tBACKCOLOUR string_expression
   62          | tREAD readlist
   63          | tDATA datalist
   64          | tRESTORE
   65          | tRESTORE symbol_or_lineno
   66          | tRETURN
   67          | tRETURN expression
   68          | tRETURN string_expression
   69          | tDIM dimlist
   70          | tOPEN tWINDOW expression ',' expression
   71          | tOPEN tWINDOW expression ',' expression ',' string_expression
   72          | tWINDOW tORIGIN string_expression
   73          | tDOT coordinates
   74          | tCLEAR tDOT coordinates
   75          | tLINE coordinates to coordinates
   76          | tCLEAR tLINE coordinates to coordinates
   77          | tLINE tTO coordinates
   78          | tLINE coordinates
   79          | tCLEAR tLINE tTO coordinates
   80          | tCLEAR tLINE coordinates
   81          | tPUTBIT string_expression to expression ',' expression ',' string_expression
   82          | tPUTBIT string_expression to expression ',' expression
   83          | tPUTCHAR string_expression to expression ',' expression
   84          | tNEW tCURVE
   85          | tCLOSE tCURVE
   86          | clear_fill_clause tCIRCLE coordinates ',' expression
   87          | clear_fill_clause tTRIANGLE coordinates to coordinates to coordinates
   88          | tTEXT coordinates ',' string_expression
   89          | tTEXT coordinates ',' string_expression ',' string_expression
   90          | tTEXT coordinates ',' string_expression ',' string_expression ',' string_expression
   91          | clear_fill_clause tRECT coordinates to coordinates
   92          | tCLOSE tWINDOW
   93          | tCLEAR tWINDOW
   94          | tCLEAR tSCREEN
   95          | tOPEN tPRINTER
   96          | tOPEN tPRINTER string_expression
   97          | tCLOSE tPRINTER
   98          | tWAIT expression
   99          | tBELL
  100          | tINKEY
  101          | tINKEY '(' ')'
  102          | tINKEY '(' expression ')'
  103          | tSYSTEM '(' string_expression ')'
  104          | tPOKE string_expression ',' string_expression
  105          | tPOKE string_expression ',' expression
  106          | tPOKE hashed_number ',' string_expression
  107          | tPOKE hashed_number ',' expression
  108          | tEND
  109          | tEXIT
  110          | tEXIT expression
  111          | tDOCU
  112          | tBIND string_expression
  113          | tFRNBF_FREE string_expression
  114          | tFRNBF_SET string_expression ',' expression ',' string_expression ',' expression
  115          | tFRNBF_SET string_expression ',' expression ',' string_expression
  116          | tFRNBF_SET_BUFFER string_expression ',' expression ',' string_expression
  117          | tBEAM_CLOSE '(' expression ')'
  118          | tBEAM_TITLE '(' expression ',' string_expression ')'
  119          | tBEAM_SIZE '(' expression ',' expression ',' expression ')'
  120          | tBEAM_BEGIN '(' expression ')'
  121          | tBEAM_END '(' expression ')'
  122          | tBEAM_LABEL '(' string_expression ')'
  123          | tBEAM_TEXT '(' string_expression ',' expression ',' expression ')'
  124          | tBEAM_IMAGE '(' string_expression ',' expression ',' expression ')'
  125          | tBEAM_PROGRESS '(' expression ',' expression ',' expression ',' expression ')'
  126          | tBEAM_SEPARATOR '(' ')'
  127          | tBEAM_SPACING '(' expression ')'
  128          | tBEAM_ROW '(' expression ',' expression ')'
  129          | tBEAM_ROW_END '(' ')'
  130          | tBEAM_GROUP_BEGIN '(' string_expression ')'
  131          | tBEAM_GROUP_END '(' ')'
  132          | tBEAM_PANEL_BEGIN '(' string_expression ',' expression ',' expression ')'
  133          | tBEAM_PANEL_END '(' ')'
  134          | tBEAM_SET_COLOR '(' expression ',' expression ',' expression ')'
  135          | tBEAM_SET_STYLE '(' string_expression ')'
  136          | tBEAM_SLEEP '(' expression ')'

  137 clear_fill_clause: ε
  138                  | tCLEAR
  139                  | tFILL
  140                  | tCLEAR tFILL
  141                  | tFILL tCLEAR

  142 string_assignment: tSTRSYM tEQU string_expression
  143                  | tMID '(' string_scalar_or_array ',' expression ',' expression ')' tEQU string_expression
  144                  | tMID '(' string_scalar_or_array ',' expression ')' tEQU string_expression
  145                  | tLEFT '(' string_scalar_or_array ',' expression ')' tEQU string_expression
  146                  | tRIGHT '(' string_scalar_or_array ',' expression ')' tEQU string_expression
  147                  | stringfunction_or_array tEQU string_expression

  148 to: ','
  149   | tTO

  150 open_clause: tOPEN hashed_number ',' string_expression ',' string_expression
  151            | tOPEN hashed_number ',' string_expression
  152            | tOPEN hashed_number ',' tPRINTER
  153            | tOPEN string_expression tFOR tREADING tAS hashed_number
  154            | tOPEN string_expression tFOR tWRITING tAS hashed_number

  155 seek_clause: tSEEK hashed_number ',' expression
  156            | tSEEK hashed_number ',' expression ',' string_expression

  157 string_scalar_or_array: tSTRSYM
  158                       | tSTRSYM '(' call_list ')'

  159 string_expression: tSTRSYM
  160                  | string_function
  161                  | stringfunction_or_array
  162                  | tSTRING
  163                  | string_expression '+' string_expression
  164                  | '(' string_expression ')'

  165 string_function: tLEFT '(' string_expression ',' expression ')'
  166                | tRIGHT '(' string_expression ',' expression ')'
  167                | tMID '(' string_expression ',' expression ',' expression ')'
  168                | tMID '(' string_expression ',' expression ')'
  169                | tSTR '(' expression ')'
  170                | tSTR '(' expression ',' string_expression ')'
  171                | tSTR '(' expression ',' string_expression ',' string_expression ')'
  172                | tSTR '(' string_expression ')'
  173                | tINKEY
  174                | tINKEY '(' ')'
  175                | tINKEY '(' expression ')'
  176                | tCHR '(' expression ')'
  177                | tUPPER '(' string_expression ')'
  178                | tLOWER '(' string_expression ')'
  179                | tLTRIM '(' string_expression ')'
  180                | tRTRIM '(' string_expression ')'
  181                | tTRIM '(' string_expression ')'
  182                | tCHOMP '(' string_expression ')'
  183                | tSYSTEM2 '(' string_expression ')'
  184                | tFRNFN_CALL2 '(' call_list ')'
  185                | tFRNBF_ALLOC '(' expression ')'
  186                | tFRNBF_DUMP '(' string_expression ')'
  187                | tFRNBF_DUMP '(' string_expression ',' expression ')'
  188                | tDATE
  189                | tDATE '(' ')'
  190                | tTIME
  191                | tTIME '(' ')'
  192                | tPEEK2 '(' string_expression ')'
  193                | tPEEK2 '(' string_expression ',' string_expression ')'
  194                | tTOKENALT '(' string_scalar_or_array ',' string_expression ')'
  195                | tTOKENALT '(' string_scalar_or_array ')'
  196                | tSPLITALT '(' string_scalar_or_array ',' string_expression ')'
  197                | tSPLITALT '(' string_scalar_or_array ')'
  198                | tGETBIT '(' coordinates to coordinates ')'
  199                | tGETCHAR '(' expression ',' expression to expression ',' expression ')'
  200                | tHEX '(' expression ')'
  201                | tBIN '(' expression ')'
  202                | tEXECUTE2 '(' call_list ')'
  203                | tFRNBF_GET2 '(' string_expression ',' expression ',' expression ')'
  204                | tFRNBF_GET_BUFFER '(' string_expression ',' expression ')'
  205                | tEVAL2 '(' string_expression ')'
  206                | tBEAM_OPEN_FILE '(' string_expression ')'
  207                | tBEAM_SAVE_FILE '(' string_expression ')'

  208 number_assignment: tSYMBOL tEQU expression
  209                  | function_or_array tEQU expression

  210 $@9: ε

  211 expression: expression tOR $@9 expression

  212 $@10: ε

  213 expression: expression tAND $@10 expression
  214           | tNOT expression
  215           | expression tEQU expression
  216           | expression tEQU2 expression
  217           | expression tNEQ expression
  218           | expression tLTN expression
  219           | expression tLEQ expression
  220           | expression tGTN expression
  221           | expression tGEQ expression
  222           | tMYEOF '(' hashed_number ')'
