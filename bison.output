  228           | tARSIZE '(' string_arrayref ',' expression ')'
  229           | function_or_array
  230           | tSYMBOL
  231           | expression '+' expression
  232           | expression '-' expression
  233           | expression '*' expression
  234           | expression '/' expression
  235           | expression tPOW expression
  236           | '-' expression
