  286         | tFRNBF_SIZE '(' string_expression ')'
  287         | tPEEK '(' hashed_number ')'
  288         | tPEEK '(' string_expression ')'
  289         | tMOUSEX '(' string_expression ')'
  290         | tMOUSEX
